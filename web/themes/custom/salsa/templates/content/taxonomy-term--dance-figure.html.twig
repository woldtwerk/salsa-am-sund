{#
/**
 * @file
 * Dance figure detail page.
 *
 * The page title block prints the figure name, so this template only renders
 * the figure's own content: the difficulty, the video, the description, the
 * personal flags and the link back to the overview.
 *
 * Available variables:
 * - term: The dance figure term.
 * - content: The rendered term fields.
 * - attributes: Attributes for the article wrapper.
 * - dance_figure_levels: One formatted difficulty label per field value.
 * - dance_figure_has_video: Whether the term has a video.
 * - dance_figure_has_description: Whether the term has a description.
 */
#}
{% set levels = dance_figure_levels|default([]) %}
{% set description = content.description is defined ? content.description|render : '' %}
{% set video = content.field_video is defined ? content.field_video|render : '' %}
{% set learned_flag = content.flag_learned is defined ? content.flag_learned|render : '' %}
{% set like_flag = content.flag_like is defined ? content.flag_like|render : '' %}
{% set has_flags = learned_flag|trim is not empty or like_flag|trim is not empty %}

<article{{ attributes.addClass('min-w-0') }}>
  {% if levels %}
    <div class="flex flex-wrap items-center gap-2">
      {% for level in levels %}
        <span class="inline-flex items-center rounded-full border border-flame-gold/40 bg-flame-gold/10 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-flame-gold">
          {{ level }}
        </span>
      {% endfor %}
    </div>
  {% endif %}

  {% if dance_figure_has_video and video|trim is not empty %}
    <div class="relative mt-8 aspect-video w-full overflow-hidden rounded-2xl border border-line bg-ink-2 [&_iframe]:absolute [&_iframe]:inset-0 [&_iframe]:h-full [&_iframe]:w-full [&_video]:absolute [&_video]:inset-0 [&_video]:h-full [&_video]:w-full [&_video]:object-contain">
      {{ video }}
    </div>
  {% endif %}

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] lg:gap-16">
    <div class="min-w-0">
      {% if dance_figure_has_description and description|striptags|trim is not empty %}
        <div class="prose max-w-none">{{ description }}</div>
      {% endif %}

      {% if has_flags %}
        <div class="flex flex-wrap items-center gap-3 [&_.flag]:contents [&_a]:inline-flex [&_a]:w-fit [&_a]:items-center [&_a]:justify-center [&_a]:gap-2.5 [&_a]:rounded-full [&_a]:px-6 [&_a]:py-3 [&_a]:font-semibold [&_a]:no-underline [&_a]:transition [&_a]:duration-200 [&_a]:ease-out [&_.flag-learned_a]:bg-flame-deep [&_.flag-learned_a]:text-white [&_.flag-learned_a]:shadow-[0_14px_34px_-16px_rgb(143_15_22_/_0.9)] [&_.flag-learned_a]:hover:brightness-95 [&_.flag-learned_a]:hover:text-white [&_.flag-like_a]:border [&_.flag-like_a]:border-line [&_.flag-like_a]:bg-transparent [&_.flag-like_a]:text-sand [&_.flag-like_a]:hover:bg-flame-gold/10">
          {{ learned_flag }}
          {{ like_flag }}
        </div>
      {% endif %}
    </div>

    <aside class="min-w-0 self-start">
      <div class="rounded-2xl border border-line bg-ink-2 p-5 md:p-6">
        <a href="{{ path('view.dance_figures.page_1') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-mist no-underline hover:text-flame-gold">
          {{ icon('salsa', 'chevron-left', {size: 16}) }}
          {{ 'Back to dance figures'|t }}
        </a>
      </div>
    </aside>
  </div>
</article>
