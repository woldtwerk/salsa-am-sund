{#
/**
 * @file
 * Main navigation: horizontal on desktop with click-triggered popover
 * submenus, stacked and expanded on mobile.
 *
 * Submenus are native popovers (Popover API + CSS anchor positioning): no
 * JavaScript. The parent link stays a link; the chevron button is the
 * popovertarget. Each level-2 list is a `popover="auto"` element anchored to
 * its menu row via an inline `anchor-name`, so it opens below the row on
 * click, closes on light dismiss or Escape, and only one opens at a time. On
 * mobile the toggle is hidden and the same list renders in normal flow,
 * expanded under its parent.
 *
 * Available variables:
 * - items: Nested menu items.
 * - attributes: Attributes for the root list.
 * - menu_name: Machine name of the menu.
 */
#}
{% import _self as menus %}
{% set root_attributes = attributes|default(create_attribute()) %}

{{ menus.menu_links(items, root_attributes, 1, null) }}

{% macro menu_links(items, attributes, level, submenu_id) %}
  {% import _self as menus %}
  {% if items %}
    {% if level == 1 %}
      <ul{{ attributes.addClass('salsa-menu', 'm-0', 'flex', 'list-none', 'flex-col', 'gap-1', 'p-0', 'lg:flex-row', 'lg:items-center') }}>
    {% elseif level == 2 %}
      <ul id="{{ submenu_id }}" popover="auto" style="position-anchor: --{{ submenu_id }}" class="salsa-menu__submenu m-0 mt-1 flex list-none flex-col gap-1 p-0 ps-4 lg:mt-2 lg:min-w-56 lg:rounded-xl lg:border lg:border-line lg:bg-ink-2 lg:p-2 lg:ps-2 lg:shadow-2xl">
    {% else %}
      <ul class="m-0 mt-1 flex list-none flex-col gap-1 p-0 ps-4">
    {% endif %}
      {% for item in items %}
        {% set has_children = item.below is not empty %}
        {% set is_active = item.in_active_trail %}
        {% set link_classes = [
          'salsa-menu__link',
          'group/link flex items-center gap-2 rounded-lg px-3 py-2 text-base no-underline transition-colors',
          is_active ? 'text-flame-gold bg-sand/5' : 'text-sand hover:text-flame-gold hover:bg-sand/10',
          level == 2 ? 'text-sm' : '',
        ]|filter(class => class is not empty) %}

        <li class="salsa-menu__item relative {{ has_children ? 'group' : '' }}" data-menu-level="{{ level }}">
          {% if has_children and level == 1 %}
            {% set submenu_key = ('salsa-submenu-' ~ item.original_link.pluginId)|clean_id %}
            <div class="salsa-menu__row flex items-center gap-0.5" style="anchor-name: --{{ submenu_key }}">
              {% if item.url is not empty %}
                <a href="{{ item.url }}" class="{{ link_classes|join(' ') }}"{% if is_active %} aria-current="page"{% endif %}>
                  <span>{{ item.title }}</span>
                </a>
              {% else %}
                <span class="{{ link_classes|join(' ') }}">{{ item.title }}</span>
              {% endif %}

              <button
                type="button"
                popovertarget="{{ submenu_key }}"
                class="salsa-submenu__toggle inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-lg text-sand transition-colors hover:bg-sand/10 hover:text-flame-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-flame-gold"
                aria-label="{{ 'Submenu: @title'|t({'@title': item.title}) }}"
              >
                {{ icon('salsa', 'chevron-down', {
                  size: 18,
                  class: 'salsa-submenu__chevron shrink-0 transition-transform duration-200',
                }) }}
              </button>
            </div>

            {{ menus.menu_links(item.below, null, level + 1, submenu_key) }}
          {% elseif item.url is not empty %}
            <a href="{{ item.url }}" class="{{ link_classes|join(' ') }}"{% if is_active %} aria-current="page"{% endif %}>
              <span>{{ item.title }}</span>
            </a>
          {% else %}
            <span class="{{ link_classes|join(' ') }}">{{ item.title }}</span>
          {% endif %}

          {% if has_children and level != 1 %}
            {{ menus.menu_links(item.below, null, level + 1, null) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
