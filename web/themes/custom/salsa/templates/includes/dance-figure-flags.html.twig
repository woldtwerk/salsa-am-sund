{#
/**
 * @file
 * Personal flag buttons of a dance figure.
 *
 * Shared by the dance figure detail page and the overview cards. The flags are
 * rendered by Flag, so their HTMX toggle and BigPipe placeholders keep working.
 *
 * Available variables:
 * - flags: The rendered flag link render arrays.
 */
#}
{% set flags_output = [] %}
{% for flag in flags|default([]) %}
  {% set flags_output = flags_output|merge([flag|render]) %}
{% endfor %}
{% if flags_output|join('')|trim is not empty %}
  <div class="flex flex-wrap items-center gap-3 [&_.flag]:contents [&_a]:inline-flex [&_a]:w-fit [&_a]:items-center [&_a]:justify-center [&_a]:gap-2.5 [&_a]:rounded-full [&_a]:px-6 [&_a]:py-3 [&_a]:font-semibold [&_a]:no-underline [&_a]:transition [&_a]:duration-200 [&_a]:ease-out [&_.flag-learned_a]:bg-flame-deep [&_.flag-learned_a]:text-white [&_.flag-learned_a]:shadow-[0_14px_34px_-16px_rgb(143_15_22_/_0.9)] [&_.flag-learned_a]:hover:brightness-95 [&_.flag-learned_a]:hover:text-white [&_.flag-like_a]:border [&_.flag-like_a]:border-line [&_.flag-like_a]:bg-transparent [&_.flag-like_a]:text-sand [&_.flag-like_a]:hover:bg-flame-gold/10">
    {% for flag in flags_output %}
      {{ flag }}
    {% endfor %}
  </div>
{% endif %}
