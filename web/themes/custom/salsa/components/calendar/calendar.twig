{#
  Event calendar.

  The filter bar is shared by the card list and the calendar. The cards are
  rendered by the block, so they work without JavaScript; the calendar is a
  self-hosted FullCalendar web component that loads the occurrences from the
  JSON endpoint. calendar.js filters the cards, sets the calendar options and
  keeps the filter state in the page URL and in localStorage. Without
  JavaScript the calendar is not rendered, hence the <noscript> fallback to
  the iCal feed.
#}

{% set button = html_cva(
  base: [
    'inline-flex w-fit items-center justify-center gap-2.5 rounded-full font-semibold no-underline',
    'transition duration-200 ease-out hover:no-underline',
  ],
  variants: {
    variant: {
      flame: 'bg-flame-deep text-white shadow-[0_14px_34px_-16px_rgb(143_15_22_/_0.9)] hover:brightness-95 hover:text-white',
      outline: 'border border-[var(--surface-border)] bg-transparent text-[var(--surface-fg)] hover:bg-flame-gold/10',
    },
    size: {
      md: 'px-5 py-2.5 text-sm',
    },
  }
) %}
{% set focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-flame-gold' %}

<div
  class="{{ tw_merge(['salsa-surface-dark w-full rounded-2xl border border-line bg-ink p-4 text-sand md:p-6', ui.root|default('')]) }}"
  data-salsa-calendar
  data-events-url="{{ events_url }}"
  data-all-organizers="{{ organizers|column('value')|join(',') }}"
>
  <div data-salsa-calendar-filters class="grid gap-4 sm:grid-cols-[2fr_1fr]">
    <fieldset class="min-w-0 rounded-xl border border-line/70 bg-ink-2/40 p-4">
      <legend class="px-1 font-body text-xs font-semibold uppercase tracking-[0.2em] text-flame-gold">
        {{ 'Organizers'|t }}
      </legend>
      <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
        {% for organizer in organizers %}
          <label class="flex cursor-pointer items-center gap-2 rounded-lg p-1 transition-colors hover:bg-flame-gold/5 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-flame-gold">
            <input
              type="checkbox"
              name="organizer"
              value="{{ organizer.value }}"
              class="size-4 shrink-0 accent-flame-orange {{ focus }}"
              checked
            >
            <span class="min-w-0 text-sm font-semibold text-sand">{{ organizer.label }}</span>
          </label>
        {% endfor %}
      </div>
    </fieldset>

    <fieldset class="min-w-0 rounded-xl border border-line/70 bg-ink-2/40 p-4">
      <legend class="px-1 font-body text-xs font-semibold uppercase tracking-[0.2em] text-flame-gold">
        {{ 'Type'|t({}, {'context': 'salsa'}) }}
      </legend>
      <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
        <label class="flex cursor-pointer items-center gap-2 rounded-lg p-1 transition-colors hover:bg-flame-gold/5 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-flame-gold">
          <input
            type="checkbox"
            name="parties"
            value="1"
            data-salsa-calendar-parties
            class="size-4 shrink-0 accent-flame-orange {{ focus }}"
            checked
          >
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-sand">
            <span class="size-2.5 shrink-0 rounded-full bg-flame-orange" aria-hidden="true"></span>
            {{ 'Parties'|t }}
          </span>
        </label>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg p-1 transition-colors hover:bg-flame-gold/5 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-flame-gold">
          <input
            type="checkbox"
            name="courses"
            value="1"
            data-salsa-calendar-courses
            class="size-4 shrink-0 accent-flame-gold {{ focus }}"
            checked
          >
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-sand">
            <span class="size-2.5 shrink-0 rounded-full bg-flame-gold" aria-hidden="true"></span>
            {{ 'Courses'|t }}
          </span>
        </label>
      </div>
    </fieldset>
  </div>

  {% embed 'salsa:tabs' with {param: 'ansicht', align: 'end'} %}
    {% block tabs %}
      {% embed 'salsa:tab' with {label: ('Cards'|t) ~ '', name: 'karten', icon: 'layout-grid'} %}
        {% block content %}
          <div data-salsa-calendar-cards>{{ cards }}</div>
          <p data-salsa-calendar-empty hidden class="mt-5 text-sm leading-relaxed text-mist">
            {{ 'No events for this selection.'|t }}
          </p>
          <button
            type="button"
            data-salsa-calendar-more
            hidden
            class="{{ tw_merge([button.apply({variant: 'outline', size: 'md'}), 'mt-6', focus]) }}"
          >
            {{ 'Show more'|t }}
          </button>
        {% endblock %}
      {% endembed %}

      {% embed 'salsa:tab' with {label: ('Calendar'|t) ~ '', name: 'kalender', icon: 'calendar'} %}
        {% block content %}
          <full-calendar
            id="{{ id }}"
            class="salsa-calendar mt-5 block"
            aria-label="{{ 'Event calendar'|t }}"
          ></full-calendar>

          <noscript>
            <p class="mt-4 rounded-xl border border-dashed border-line/70 bg-ink-2/30 p-4 text-sm text-mist">
              {{ 'The calendar requires JavaScript. You can find all events in the iCal feed.'|t }}
            </p>
            <p class="mt-3">
              <a href="{{ ical_url }}" class="{{ tw_merge([button.apply({variant: 'outline', size: 'md'}), focus]) }}">
                {{ 'Download events as .ics'|t }}
              </a>
            </p>
          </noscript>
        {% endblock %}
      {% endembed %}
    {% endblock %}
  {% endembed %}

  {{ subscribe }}
</div>
