{% set day = day|default('montag') %}
{% set is_link = href is not empty %}
{% set is_external = location_href is not empty and location_href matches '#^(https?:)?//#' %}

<div class="@container h-full min-w-0">
<article class="{{ tw_merge(['salsa-surface-dark relative flex h-full min-w-0 flex-col rounded-2xl border border-line bg-ink-2 p-5 transition-colors duration-300 hover:border-flame-gold/50 @md:p-6', ui.root|default('')]) }}">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line/70 pb-3">
    <span class="font-body text-xs font-semibold uppercase tracking-[0.24em] text-flame-gold">{{ day|capitalize }}</span>
    <span class="font-display text-xl leading-none font-bold italic text-sand @md:text-2xl">{{ time }}</span>
  </div>

  <h3 class="mt-4 font-display text-2xl leading-tight font-bold italic text-sand @md:text-3xl">
    {% if is_link %}
      <a
        href="{{ href }}"
        class="no-underline text-inherit after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-flame-gold"
      >{{ title }}</a>
    {% else %}
      {{ title }}
    {% endif %}
  </h3>

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-mist">
    {% if level %}
      <span class="inline-flex items-center rounded-full border border-flame-gold/40 bg-flame-gold/10 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-flame-gold">
        {{ level }}
      </span>
    {% endif %}

    {% if location %}
      {% if location_href %}
        <a
          href="{{ location_href }}"
          class="relative z-10 inline-flex max-w-full flex-wrap items-center gap-1.5 text-sm text-mist no-underline hover:text-flame-gold"
          {% if is_external %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          {{ icon('salsa', 'map-pin', {size: 16}) }}
          {{ location }}
        </a>
      {% else %}
        <span class="inline-flex max-w-full flex-wrap items-center gap-1.5">
          {{ icon('salsa', 'map-pin', {size: 16}) }}
          {{ location }}
        </span>
      {% endif %}
    {% endif %}
  </div>
</article>
</div>
