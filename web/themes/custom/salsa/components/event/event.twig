{% set months = {
  1: 'JAN'|t, 2: 'FEB'|t, 3: 'MAR'|t, 4: 'APR'|t, 5: 'MAY'|t, 6: 'JUN'|t,
  7: 'JUL'|t, 8: 'AUG'|t, 9: 'SEP'|t, 10: 'OCT'|t, 11: 'NOV'|t, 12: 'DEC'|t
} %}
{% set day_number = date|date('j') %}
{% set month_number = date|date('n') %}
{% set year = date|date('Y') %}
{% set is_link = href is not empty %}
{% set is_external = is_link and href matches '#^(https?:)?//#' %}
{% set kind = kind|default('') %}
{% set is_event = kind == 'event' %}
{% set is_course = kind == 'course' %}
{% set day_colour = is_course ? 'text-flame-gold' : 'text-flame-light' %}
{% set badge_colours = is_course
  ? 'border-flame-gold/40 bg-flame-gold/10 text-flame-gold'
  : 'border-flame-orange/40 bg-flame-orange/10 text-flame-orange' %}

<div class="@container h-full min-w-0">
<article class="{{ tw_merge(['salsa-surface-dark group relative flex h-full min-w-0 flex-col gap-5 rounded-2xl border border-line bg-ink-2 p-5 transition-colors duration-300 hover:border-flame-gold/50 @md:flex-row @md:p-6', ui.root|default('')]) }}">
  <div class="shrink-0 @md:w-32">
    <time datetime="{{ date }}" class="flex items-start gap-2 @md:flex-col @md:gap-0">
      <span class="font-display text-5xl leading-none font-black italic tracking-tight {{ day_colour }} @md:text-6xl">{{ day_number }}</span>
      <span class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-flame-gold @md:mt-2">
        {{ months[month_number] }}<span class="sr-only"> {{ year }}</span>
      </span>
      <span class="font-body text-xs text-mist @md:mt-1" aria-hidden="true">{{ year }}</span>
    </time>
    {% if time %}
      <p class="mt-3 inline-flex items-center gap-1.5 text-sm text-mist">
        {{ icon('salsa', 'clock', {size: 16}) }}
        {{ time }}
      </p>
    {% endif %}
  </div>

  <div class="min-w-0 flex-1">
    {% if is_event or is_course %}
      <span class="mb-2 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide {{ badge_colours }}">
        {{ is_course ? 'Course'|t : 'Party'|t }}
      </span>
    {% endif %}
    <h3 class="font-display text-2xl leading-tight font-bold italic text-sand @md:text-3xl">
      {% if is_link %}
        <a
          href="{{ href }}"
          class="text-inherit no-underline after:absolute after:inset-0 after:content-[''] hover:text-flame-gold"
          {% if is_external %}target="_blank" rel="noopener noreferrer"{% endif %}
        >{{ title }}</a>
      {% else %}
        {{ title }}
      {% endif %}
    </h3>

    {% if location %}
      <p class="mt-2 inline-flex max-w-full flex-wrap items-center gap-1.5 text-sm text-mist">
        {{ icon('salsa', 'map-pin', {size: 16}) }}
        {{ location }}
      </p>
    {% endif %}

    {% if text %}
      <div class="prose mt-3 max-w-none prose-a:relative prose-a:z-10">
        {{ text }}
      </div>
    {% endif %}

    {% if ical_href %}
      <p class="mt-3">
        <a href="{{ ical_href }}" download class="relative z-10 inline-flex items-center gap-1.5 text-sm font-semibold text-mist no-underline hover:text-flame-gold">
          {{ icon('salsa', 'calendar', {size: 16}) }}
          <span>{{ 'Add to calendar'|t }}</span>
          <span class="sr-only">: {{ title }}, {{ date|date('d.m.Y') }}</span>
        </a>
      </p>
    {% endif %}
  </div>
</article>
</div>
