{% set picture = picture|default({}) %}
{% set name = name|default('') %}
{% set words = name|split(' ') %}
{% set initials = '' %}
{% for word in words %}
  {% set initials = initials ~ (word|first) %}
{% endfor %}
{% set initials = initials|upper|slice(0, 2) %}

<section class="{{ tw_merge(['salsa-surface-dark relative overflow-hidden rounded-3xl border border-line bg-ink-2 p-6 shadow-[0_28px_70px_-42px_rgb(224_38_27_/_0.75)] md:p-8', ui.root|default('')]) }}">
  <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:text-left">
    <div class="{{ tw_merge(['flex size-28 shrink-0 items-center justify-center overflow-hidden rounded-full border border-line/70 bg-ink md:size-36', ui.avatar|default('')]) }}">
      {% if picture.src is not empty %}
        {% include 'canvas:image' ignore missing with {
          src: picture.src,
          alt: picture.alt|default(name),
          width: picture.width,
          height: picture.height,
          class: 'h-full w-full object-cover',
          sizes: '9rem',
          loading: 'lazy',
        } only %}
      {% else %}
        <span class="flex h-full w-full items-center justify-center bg-flame-light font-display text-4xl font-black italic text-night md:text-5xl" aria-hidden="true">
          {{ initials }}
        </span>
      {% endif %}
    </div>

    <div class="min-w-0">
      <h1 class="{{ tw_merge(['font-display text-3xl leading-[1.02] font-extrabold italic text-balance text-sand md:text-4xl', ui.name|default('')]) }}">
        {{ name }}
      </h1>
      {% if member_since %}
        <p class="{{ tw_merge(['mt-2 font-body text-sm leading-relaxed text-mist', ui.meta|default('')]) }}">
          {{ member_since }}
        </p>
      {% endif %}
    </div>
  </div>

  {% if content %}
    <div class="{{ tw_merge(['prose mt-6 flex flex-col gap-8 max-w-none [&_h3]:mt-0', ui.content|default('')]) }}">
      {{ content }}
    </div>
  {% endif %}
</section>
