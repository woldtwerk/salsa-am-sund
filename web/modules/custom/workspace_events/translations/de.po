msgstr "Kategorien"

msgid "One category per line, in the format \"key|Label\". Keys may contain lowercase letters, numbers and underscores. Renaming a label keeps existing prices. A key that is still used cannot be removed automatically; check the saved prices first."
msgstr "Eine Kategorie pro Zeile im Format \"Schlüssel|Bezeichnung\". Schlüssel dürfen nur Kleinbuchstaben, Zahlen und Unterstriche enthalten. Eine Bezeichnung umzubenennen behält bestehende Preise bei. Ein noch verwendeter Schlüssel kann nicht automatisch entfernt werden; prüfe zuerst die gespeicherten Preise."

msgid "Line @line: use the format \"key|Label\"."
msgstr "Zeile @line: Verwende das Format \"Schlüssel|Bezeichnung\"."

msgid "Line @line: the key \"@key\" may only contain lowercase letters, numbers and underscores."
msgstr "Zeile @line: Der Schlüssel \"@key\" darf nur Kleinbuchstaben, Zahlen und Unterstriche enthalten."

msgid "Line @line: the key \"@key\" is longer than 64 characters."
msgstr "Zeile @line: Der Schlüssel \"@key\" ist länger als 64 Zeichen."

msgid "Line @line: the key \"@key\" is used twice."
msgstr "Zeile @line: Der Schlüssel \"@key\" wird doppelt verwendet."

msgid "Line @line: the label must not be empty."
msgstr "Zeile @line: Die Bezeichnung darf nicht leer sein."

msgid "At least one category is required."
msgstr "Mindestens eine Kategorie ist erforderlich."

msgid "@category: @amount per lesson"
msgstr "@category: @amount pro Stunde"
