# German translation of the workspace_events module.
#
# English is the source language: the msgids are the literals passed to t(),
# formatPlural() and TranslatableMarkup() in this module's PHP. Imported into
# Drupal's locale storage with:
#
#   drush locale:import de modules/custom/workspace_events/translations/de.po \
#     --type=customized --override=all
#
# The content model labels in config/install (Termin, Datum & Uhrzeit, Art, Ort,
# Level, Weitere Infos (Link), Beschreibung, Orte, Adresse, Kartenlink, Kurs,
# Party, Externe Party) are German already and need no translation.
#
# Informal "du".
#
msgid ""
