<?php

/**
 * @file
 * Install, update and uninstall functions for the workspace_events module.
 */

declare(strict_types=1);

use Drupal\Core\Field\DeletedFieldsRepositoryInterface;
use Drupal\Core\Field\FieldPurger;
use Drupal\Core\Utility\UpdateException;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;
use Drupal\user\Entity\Role;
use Drupal\workspace_events\AttendanceRecognition;
use Drupal\workspace_events\CourseDifficultyMigrator;
use Drupal\workspace_events\DanceFigureFlag;
use Drupal\workspace_events\Hook\DanceFigureAccessHooks;
use Drupal\workspace_events\LessonInstaller;
use Drupal\workspace_events\OrganizerResolver;
use Drupal\workspace_events\ScheduleMigrator;

/**
 * Implements hook_install().
 */
function workspace_events_install(bool $is_syncing = FALSE): void {
  workspace_events_ensure_organizer_vocabulary();
  if (!$is_syncing) {
    // While modules are being installed from configuration (site install,
    // kernel tests) the content entity schemas do not exist yet, so the terms
    // are created after the configuration has been imported.
    workspace_events_ensure_organizer_terms();
  }
  workspace_events_grant_editor_permissions();
}

/**
 * Implements hook_uninstall().
 */
function workspace_events_uninstall(): void {
  workspace_events_revoke_editor_permissions();
  workspace_events_revoke_flag_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Adds the course bundle to the editorial workflow and grants the course
 * permissions on sites that installed the module before courses were split
 * out of the event bundle.
 */
function workspace_events_update_10001(): void {
  workspace_events_set_bundle_in_workflow('course', TRUE);
  workspace_events_grant_editor_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Adds the organizer vocabulary, its fixed terms and the organizer field to
 * existing sites and grants the organizer permissions to the content editor
 * role.
 */
function workspace_events_update_10002(): void {
  workspace_events_ensure_organizer_vocabulary();
  workspace_events_ensure_organizer_terms();
  workspace_events_ensure_organizer_field();
  workspace_events_grant_editor_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Renames the organizer term "Extern" to "Sonstige".
 */
function workspace_events_update_10003(): void {
  workspace_events_rename_external_organizer();
}

/**
 * Implements hook_update_N().
 *
 * Replaces the free-text course level with the shared difficulty scale and
 * migrates the existing course values.
 */
function workspace_events_update_10004(): void {
  $migrator = \Drupal::service(CourseDifficultyMigrator::class);
  \assert($migrator instanceof CourseDifficultyMigrator);
  $migrator->migrate();
}

/**
 * Implements hook_update_N().
 *
 * Installs the season and lesson entity types, their fields, adds the course
 * and event date fields and migrates the existing Smart Date series.
 *
 * Seasons and lessons are fieldable content entities without bundles, so the
 * entity types themselves are installed first. A season owns its lessons, so
 * the course_season entity type is installed before lesson: the lesson base
 * fields reference the season. Scheduler's fields are added to lessons after
 * both entity types exist, before the lesson field configuration is created.
 *
 * Season schedules are configurable daterange fields, installed by the
 * installer after datetime_range: the course_season entity type itself uses no
 * field type from a module that may still be missing on an older site.
 *
 * Courses get one season for their legacy series, and that season generates
 * its lessons. Events keep the whole Smart Date series: every delta of the
 * legacy field is copied to the new recurring event date field and the
 * recurrence rules of the events are pointed at it.
 *
 * The course field_location instance is removed by the configuration import
 * that runs after updatedb (deploy runs updb before cim), so the schedule
 * migrator can still read the location of a course here.
 */
function workspace_events_update_10007(): ?string {
  $modules = array_values(array_filter(
    ['datetime_range', 'smart_date', 'smart_date_recur'],
    static fn (string $module): bool => !\Drupal::moduleHandler()->moduleExists($module),
  ));
  if ($modules !== []) {
    \Drupal::service('module_installer')->install($modules);
  }

  // The Scheduler plugin of the lesson entity type must be discovered before
  // the entity type is installed, so that its base fields are part of the
  // installed definition.
  \Drupal::service('plugin.manager.scheduler')->clearCachedDefinitions();
  \Drupal::service('scheduler.manager')->invalidatePluginCache();

  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($definition_update_manager->getEntityType('course_season') === NULL) {
    $definition_update_manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('course_season'));
  }
  if ($definition_update_manager->getEntityType('lesson') === NULL) {
    $definition_update_manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('lesson'));
  }
  \Drupal::service('scheduler.manager')->entityUpdate();

  $installer = \Drupal::service(LessonInstaller::class);
  \assert($installer instanceof LessonInstaller);
  $installer->install();

  $migrator = \Drupal::service(ScheduleMigrator::class);
  \assert($migrator instanceof ScheduleMigrator);
  $message = $migrator->migrate();

  return $message === '' ? NULL : $message;
}

/**
 * Implements hook_update_N().
 *
 * Removes the legacy Smart Date field from courses and events.
 *
 * The schedule migration of update 10007 runs first because update hooks run
 * in number order. It copied the event series to the recurring event date
 * field and the course schedule to the lesson fields, so only the legacy field
 * and the course rules that belonged to it can go. The Smart Date modules and
 * the recurrence rules of the events stay installed.
 */
function workspace_events_update_10010(): void {
  foreach (['node.course.field_when', 'node.event.field_when'] as $name) {
    $field = FieldConfig::load($name);
    if ($field !== NULL) {
      $field->delete();
    }
  }

  $storage = FieldStorageConfig::loadByName('node', 'field_when');
  if ($storage !== NULL) {
    $storage->delete();
  }

  // The field data is deleted in batches, so a large site does not run out of
  // memory.
  workspace_events_purge_deleted_fields();

  // The course rules belonged to the removed legacy field. Deleting a rule also
  // deletes its overrides. The event rules now belong to the recurring event
  // date field and are kept.
  workspace_events_delete_course_date_rules();
}

/**
 * Deletes the Smart Date rules that belonged to the legacy course field.
 */
function workspace_events_delete_course_date_rules(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('smart_date_rule')) {
    return;
  }
  $storage = $entity_type_manager->getStorage('smart_date_rule');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('entity_type', 'node')
    ->condition('bundle', 'course')
    ->condition('field_name', ScheduleMigrator::LEGACY_FIELD_NAME)
    ->execute();
  if ($ids === []) {
    return;
  }
  $storage->delete($storage->loadMultiple($ids));
}

/**
 * Implements hook_update_N().
 *
 * Removes content moderation from the site.
 *
 * The editorial workflow only moderated the page content type and none of the
 * pages has an unpublished draft, so no draft revision is lost. The ECA model
 * that added new content types to the workflow, the moderation state entities
 * and the workflow itself have to go before the modules can be uninstalled.
 */
function workspace_events_update_10013(): void {
  $entity_type_manager = \Drupal::entityTypeManager();

  if ($entity_type_manager->hasDefinition('eca')) {
    $model = $entity_type_manager->getStorage('eca')->load('auto_enable_moderation');
    if ($model !== NULL) {
      $model->delete();
    }
  }

  // Content moderation cannot be uninstalled while moderation state entities
  // exist.
  workspace_events_delete_entities('content_moderation_state');

  if ($entity_type_manager->hasDefinition('workflow')) {
    $workflow = $entity_type_manager->getStorage('workflow')->load('basic_editorial');
    if ($workflow !== NULL) {
      $workflow->delete();
    }
  }

  $installed = array_values(array_filter(
    ['scheduler_content_moderation_integration', 'content_moderation', 'workflows'],
    static fn (string $module): bool => \Drupal::moduleHandler()->moduleExists($module),
  ));
  if ($installed !== []) {
    $uninstalled = \Drupal::service('module_installer')->uninstall($installed);
    if ($uninstalled === FALSE) {
      throw new UpdateException(sprintf('The modules %s could not be uninstalled.', implode(', ', $installed)));
    }
  }
}

/**
 * Deletes and purges all removed field definitions.
 *
 * The field data is deleted in batches, so a large site does not run out of
 * memory. field_purge_batch() is deprecated in Drupal 11.4; the purger is the
 * same operation without the deprecation.
 */
function workspace_events_purge_deleted_fields(): void {
  $purger = \Drupal::service(FieldPurger::class);
  \assert($purger instanceof FieldPurger);
  $repository = \Drupal::service('entity_field.deleted_fields_repository');
  \assert($repository instanceof DeletedFieldsRepositoryInterface);
  for ($i = 0; $i < 100; $i++) {
    if ($repository->getFieldDefinitions() === [] && $repository->getFieldStorageDefinitions() === []) {
      break;
    }
    $purger->purgeBatch(50);
  }
}

/**
 * Deletes all content entities of an entity type in chunks.
 *
 * Used by the update hooks to remove entities before the module that provides
 * them is uninstalled.
 *
 * @param string $entity_type_id
 *   The entity type ID, for example "content_moderation_state".
 */
function workspace_events_delete_entities(string $entity_type_id): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition($entity_type_id)) {
    return;
  }
  $storage = $entity_type_manager->getStorage($entity_type_id);
  do {
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->range(0, 50)
      ->execute();
    if ($ids === []) {
      break;
    }
    $storage->delete($storage->loadMultiple($ids));
  } while (TRUE);
}

/**
 * Renames the fixed "Sonstige" organizer term if it still has the old label.
 *
 * Older sites created the term as "Extern". The label is only changed while it
 * still has that default, so a label an editor changed is kept.
 */
function workspace_events_rename_external_organizer(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('uuid', OrganizerResolver::EXTERNAL_UUID)
    ->range(0, 1)
    ->execute();
  if ($tids === []) {
    return;
  }
  $terms = $storage->loadMultiple($tids);
  $term = reset($terms);
  if (!$term instanceof Term) {
    return;
  }
  if ((string) $term->label() !== 'Extern') {
    return;
  }
  $term->setName('Sonstige');
  $term->save();
}

/**
 * Creates the organizer vocabulary when it does not exist yet.
 *
 * The vocabulary is part of the module configuration, so it is installed from
 * config/install on new sites. The update hook covers existing sites, where
 * configuration is imported separately.
 */
function workspace_events_ensure_organizer_vocabulary(): void {
  if (Vocabulary::load(OrganizerResolver::VOCABULARY) !== NULL) {
    return;
  }
  Vocabulary::create([
    'vid' => OrganizerResolver::VOCABULARY,
    'name' => 'Veranstalter',
    'description' => 'Wer eine Veranstaltung ausrichtet',
  ])->save();
}

/**
 * Creates the fixed organizer terms.
 *
 * Idempotent: the terms are looked up by UUID, so a second run does not create
 * duplicates and never overwrites labels that editors changed.
 */
function workspace_events_ensure_organizer_terms(): void {
  if (Vocabulary::load(OrganizerResolver::VOCABULARY) === NULL) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach (OrganizerResolver::TERMS as $uuid => $term) {
    $existing = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('uuid', $uuid)
      ->range(0, 1)
      ->execute();
    if ($existing !== []) {
      continue;
    }
    Term::create([
      'uuid' => $uuid,
      'vid' => OrganizerResolver::VOCABULARY,
      'name' => $term['name'],
      'weight' => $term['weight'],
    ])->save();
  }
}

/**
 * Creates the organizer field storage and instance when they do not exist yet.
 *
 * New sites get both from config/install. The update hook creates them on
 * existing sites, so the data conversion can copy the event type into the
 * organizer field before the configuration that removes the old field is
 * imported.
 */
function workspace_events_ensure_organizer_field(): void {
  if (FieldStorageConfig::loadByName('node', 'field_organizer') === NULL) {
    FieldStorageConfig::create([
      'field_name' => 'field_organizer',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => 1,
      'settings' => ['target_type' => 'taxonomy_term'],
    ])->save();
  }
  if (FieldConfig::loadByName('node', 'event', 'field_organizer') === NULL) {
    FieldConfig::create([
      'field_name' => 'field_organizer',
      'entity_type' => 'node',
      'bundle' => 'event',
      'label' => 'Veranstalter',
      'required' => TRUE,
      'field_storage' => FieldStorageConfig::loadByName('node', 'field_organizer'),
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [OrganizerResolver::VOCABULARY => OrganizerResolver::VOCABULARY],
          'sort' => ['field' => 'weight', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
  }
}

/**
 * Adds or removes a node bundle from the basic editorial workflow.
 *
 * Does nothing when the Workflows module has been uninstalled. Idempotent:
 * nothing is saved when the workflow is missing or already has the requested
 * state.
 *
 * @param string $bundle
 *   The node bundle machine name.
 * @param bool $include
 *   TRUE to add the bundle to the workflow, FALSE to remove it.
 */
function workspace_events_set_bundle_in_workflow(string $bundle, bool $include): void {
  if (!\Drupal::moduleHandler()->moduleExists('workflows')) {
    return;
  }
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('workflow')) {
    return;
  }
  $workflow = $entity_type_manager->getStorage('workflow')->load('basic_editorial');
  if ($workflow === NULL) {
    return;
  }
  $plugin = $workflow->getTypePlugin();
  $configuration = $plugin->getConfiguration();
  $entity_types = (array) ($configuration['entity_types'] ?? []);
  $bundles = isset($entity_types['node']) && is_array($entity_types['node']) ? $entity_types['node'] : [];
  if (in_array($bundle, $bundles, TRUE) === $include) {
    return;
  }
  $bundles = $include
    ? array_values(array_merge($bundles, [$bundle]))
    : array_values(array_filter($bundles, static fn (mixed $value): bool => $value !== $bundle));
  $entity_types['node'] = $bundles;
  $configuration['entity_types'] = $entity_types;
  $plugin->setConfiguration($configuration);
  $workflow->save();
}

/**
 * Returns the permissions granted to content editors.
 *
 * @return string[]
 *   The permission names.
 */
function workspace_events_editor_permissions(): array {
  return [
    'create event content',
    'edit any event content',
    'delete any event content',
    'create course content',
    'edit any course content',
    'delete any course content',
    'create terms in location',
    'edit terms in location',
    'delete terms in location',
    'create terms in organizer',
    'edit terms in organizer',
    'delete terms in organizer',
    'create terms in dance_figure',
    'edit terms in dance_figure',
    'delete terms in dance_figure',
    'access taxonomy overview',
    'edit lessons',
    'delete lessons',
    'edit course seasons',
    'delete course seasons',
    'make smart dates recur',
    DanceFigureAccessHooks::VIEW_PERMISSION,
    AttendanceRecognition::PERMISSION,
  ];
}

/**
 * Grants the event and course permissions to the content editor role.
 */
function workspace_events_grant_editor_permissions(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  foreach (workspace_events_editor_permissions() as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Revokes the event and course permissions from the content editor role.
 */
function workspace_events_revoke_editor_permissions(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  foreach (workspace_events_editor_permissions() as $permission) {
    $role->revokePermission($permission);
  }
  $role->save();
}

/**
 * Revokes the dance figure flag permissions from the member role.
 */
function workspace_events_revoke_flag_permissions(): void {
  $role = Role::load('member');
  if ($role === NULL) {
    return;
  }
  foreach (DanceFigureFlag::cases() as $flag) {
    foreach ($flag->permissions() as $permission) {
      $role->revokePermission($permission);
    }
  }
  $role->save();
}
