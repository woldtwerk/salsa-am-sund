<?php

/**
 * @file
 * Install, update and uninstall functions for the workspace_events module.
 */

declare(strict_types=1);

use Drupal\Core\Config\Entity\ConfigEntityStorageInterface;
use Drupal\Core\Field\DeletedFieldsRepositoryInterface;
use Drupal\Core\Field\FieldPurger;
use Drupal\Core\Utility\UpdateException;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\file\FileInterface;
use Drupal\file\FileUsage\FileUsageInterface;
use Drupal\node\NodeAccessRebuild;
use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;
use Drupal\user\Entity\Role;
use Drupal\views\ViewsData;
use Drupal\workspace_events\AttendanceRecognition;
use Drupal\workspace_events\AttendanceRecognitionInstaller;
use Drupal\workspace_events\ConfigRecordLoader;
use Drupal\workspace_events\CourseDifficultyMigrator;
use Drupal\workspace_events\DanceFigureFlag;
use Drupal\workspace_events\DanceFigureInstaller;
use Drupal\workspace_events\Hook\DanceFigureAccessHooks;
use Drupal\workspace_events\LessonInstaller;
use Drupal\workspace_events\MemberOverviewInstaller;
use Drupal\workspace_events\OrganizerResolver;
use Drupal\workspace_events\ScheduleMigrator;

/**
 * Implements hook_install().
 */
function workspace_events_install(bool $is_syncing = FALSE): void {
  workspace_events_ensure_organizer_vocabulary();
  if (!$is_syncing) {
    // While modules are being installed from configuration (site install,
    // kernel tests) the content entity schemas do not exist yet, so the terms
    // are created after the configuration has been imported.
    workspace_events_ensure_organizer_terms();
  }
  workspace_events_grant_editor_permissions();
}

/**
 * Implements hook_uninstall().
 */
function workspace_events_uninstall(): void {
  workspace_events_revoke_editor_permissions();
  workspace_events_revoke_flag_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Adds the course bundle to the editorial workflow and grants the course
 * permissions on sites that installed the module before courses were split
 * out of the event bundle.
 */
function workspace_events_update_10001(): void {
  workspace_events_set_bundle_in_workflow('course', TRUE);
  workspace_events_grant_editor_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Adds the organizer vocabulary, its fixed terms and the organizer field to
 * existing sites and grants the organizer permissions to the content editor
 * role.
 */
function workspace_events_update_10002(): void {
  workspace_events_ensure_organizer_vocabulary();
  workspace_events_ensure_organizer_terms();
  workspace_events_ensure_organizer_field();
  workspace_events_grant_editor_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Renames the organizer term "Extern" to "Sonstige".
 */
function workspace_events_update_10003(): void {
  workspace_events_rename_external_organizer();
}

/**
 * Implements hook_update_N().
 *
 * Replaces the free-text course level with the shared difficulty scale and
 * migrates the existing course values.
 */
function workspace_events_update_10004(): void {
  $migrator = \Drupal::service(CourseDifficultyMigrator::class);
  \assert($migrator instanceof CourseDifficultyMigrator);
  $migrator->migrate();
}

/**
 * Implements hook_update_N().
 *
 * Adds the dance figure vocabulary, its fields and displays, the pathauto
 * pattern and the member role, and grants the new permissions to the content
 * editor role.
 */
function workspace_events_update_10005(): void {
  $installer = \Drupal::service(DanceFigureInstaller::class);
  \assert($installer instanceof DanceFigureInstaller);
  $installer->install();

  workspace_events_grant_editor_permissions();
  workspace_events_grant_member_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Installs the Flag module, adds the "mastered" flag for dance figures and
 * grants the flag permissions to the member role.
 */
function workspace_events_update_10006(): void {
  \Drupal::service('module_installer')->install(['flag']);

  $installer = \Drupal::service(DanceFigureInstaller::class);
  \assert($installer instanceof DanceFigureInstaller);
  $installer->install([DanceFigureFlag::Mastered->configName()]);

  workspace_events_grant_flag_permissions(DanceFigureFlag::Mastered);
}

/**
 * Implements hook_update_N().
 *
 * Installs the AI attendance recognition, points the Mistral provider at the
 * environment backed key, adds the participant automator action to the lesson
 * form and grants the new permission to the content editor role.
 */
function workspace_events_update_10008(): void {
  \Drupal::service('module_installer')->install([
    'key',
    'ai',
    'ai_automators',
    'field_widget_actions',
    'ai_provider_mistral',
  ]);

  $installer = \Drupal::service(AttendanceRecognitionInstaller::class);
  \assert($installer instanceof AttendanceRecognitionInstaller);
  $installer->install();

  workspace_events_grant_editor_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Adds the "like" flag for dance figures, grants the flag permissions to the
 * member role and adds the member overview pages for the dance figures and
 * the courses.
 *
 * The member views are added in this update hook together with the flag,
 * because the dance figure view needs both dance figure flags.
 */
function workspace_events_update_10009(): void {
  $installer = \Drupal::service(DanceFigureInstaller::class);
  \assert($installer instanceof DanceFigureInstaller);
  $installer->install([DanceFigureFlag::Like->configName()]);

  workspace_events_grant_flag_permissions(DanceFigureFlag::Like);

  $member_overview_installer = \Drupal::service(MemberOverviewInstaller::class);
  \assert($member_overview_installer instanceof MemberOverviewInstaller);
  $member_overview_installer->install();

  // The new view handlers use the lesson and taxonomy term field tables, so
  // the views data cache must be rebuilt.
  $views_data = \Drupal::service('views.views_data');
  if ($views_data instanceof ViewsData) {
    $views_data->clear();
  }
}

/**
 * Implements hook_update_N().
 *
 * Adds the lesson bundle, the course and event date fields and the lesson
 * fields, migrates the existing Smart Date series and generates the lessons.
 *
 * Events only keep their next upcoming date; every collapsed event series is
 * reported in the update message and in the watchdog.
 */
function workspace_events_update_10007(): ?string {
  if (!\Drupal::moduleHandler()->moduleExists('datetime_range')) {
    \Drupal::service('module_installer')->install(['datetime_range']);
  }

  $installer = \Drupal::service(LessonInstaller::class);
  \assert($installer instanceof LessonInstaller);
  $installer->install();

  // The site's ECA model adds every new content type to the editorial
  // workflow. Lessons are not moderated, so remove the new bundle again
  // before the lessons are generated.
  workspace_events_set_bundle_in_workflow('lesson', FALSE);

  workspace_events_grant_editor_permissions();

  $migrator = \Drupal::service(ScheduleMigrator::class);
  \assert($migrator instanceof ScheduleMigrator);
  $message = $migrator->migrate();

  // The module now implements node grants, so every node needs its grant
  // records: the lessons get theirs, all other bundles get the default grant.
  \Drupal::service(NodeAccessRebuild::class)->rebuild();

  return $message === '' ? NULL : $message;
}

/**
 * Implements hook_update_N().
 *
 * Removes the legacy Smart Date field and uninstalls the Smart Date modules.
 *
 * The schedule migration of update 10007 runs first because update hooks run
 * in number order.
 */
function workspace_events_update_10010(): void {
  foreach (['node.course.field_when', 'node.event.field_when'] as $name) {
    $field = FieldConfig::load($name);
    if ($field !== NULL) {
      $field->delete();
    }
  }

  $storage = FieldStorageConfig::loadByName('node', 'field_when');
  if ($storage !== NULL) {
    $storage->delete();
  }

  // The field data is deleted in batches, so a large site does not run out of
  // memory.
  workspace_events_purge_deleted_fields();

  // The permission is provided by smart_date_recur, so it is revoked before
  // the module disappears.
  foreach (Role::loadMultiple() as $role) {
    if ($role->hasPermission('make smart dates recur')) {
      $role->revokePermission('make smart dates recur');
      $role->save();
    }
  }

  // The migration of update 10007 copied the series to the lesson and event
  // date fields, so the leftover rule and override entities can go. They are
  // deleted before the uninstall, because the module installer refuses to
  // uninstall a module that still owns content.
  workspace_events_delete_entities('smart_date_override');
  workspace_events_delete_entities('smart_date_rule');

  $installed = array_values(array_filter(
    ['smart_date_recur', 'smart_date'],
    static fn (string $module): bool => \Drupal::moduleHandler()->moduleExists($module),
  ));
  if ($installed !== []) {
    $uninstalled = \Drupal::service('module_installer')->uninstall($installed);
    if ($uninstalled === FALSE) {
      throw new UpdateException(sprintf('The modules %s could not be uninstalled. Remove the remaining Smart Date content and run the update again.', implode(', ', $installed)));
    }
  }
}

/**
 * Implements hook_update_N().
 *
 * Removes the external link field from the course bundle.
 *
 * The storage of the field stays, because events still use it.
 */
function workspace_events_update_10011(): void {
  $field = FieldConfig::loadByName('node', 'course', 'field_link');
  if ($field !== NULL) {
    $field->delete();
  }
}

/**
 * Implements hook_update_N().
 *
 * Removes the course and event bundles from the editorial workflow, so only
 * pages stay moderated.
 */
function workspace_events_update_10012(): void {
  foreach (workspace_events_node_bundles() as $bundle) {
    workspace_events_set_bundle_in_workflow($bundle, FALSE);
  }
}

/**
 * Implements hook_update_N().
 *
 * Removes content moderation from the site.
 *
 * The editorial workflow only moderated the page content type and none of the
 * pages has an unpublished draft, so no draft revision is lost. The ECA model
 * that added new content types to the workflow, the moderation state entities
 * and the workflow itself have to go before the modules can be uninstalled.
 */
function workspace_events_update_10013(): void {
  $entity_type_manager = \Drupal::entityTypeManager();

  if ($entity_type_manager->hasDefinition('eca')) {
    $model = $entity_type_manager->getStorage('eca')->load('auto_enable_moderation');
    if ($model !== NULL) {
      $model->delete();
    }
  }

  // Content moderation cannot be uninstalled while moderation state entities
  // exist.
  workspace_events_delete_entities('content_moderation_state');

  if ($entity_type_manager->hasDefinition('workflow')) {
    $workflow = $entity_type_manager->getStorage('workflow')->load('basic_editorial');
    if ($workflow !== NULL) {
      $workflow->delete();
    }
  }

  $installed = array_values(array_filter(
    ['scheduler_content_moderation_integration', 'content_moderation', 'workflows'],
    static fn (string $module): bool => \Drupal::moduleHandler()->moduleExists($module),
  ));
  if ($installed !== []) {
    $uninstalled = \Drupal::service('module_installer')->uninstall($installed);
    if ($uninstalled === FALSE) {
      throw new UpdateException(sprintf('The modules %s could not be uninstalled.', implode(', ', $installed)));
    }
  }
}

/**
 * Implements hook_update_N().
 *
 * Recognizes attendance from a temporary upload instead of a stored photo.
 *
 * Deletes the attendance photo field and its files, removes the participant
 * automator and uninstalls ai_automators when no automator uses it anymore.
 */
function workspace_events_update_10014(): void {
  $entity_type_manager = \Drupal::entityTypeManager();

  if ($entity_type_manager->hasDefinition('ai_automator')) {
    $automator = $entity_type_manager->getStorage('ai_automator')->load('node.lesson.field_participants.default');
    if ($automator !== NULL) {
      $automator->delete();
    }
  }

  // The file references have to be read before the field data is purged.
  $references = workspace_events_attendance_photo_file_references();

  $field = FieldConfig::loadByName('node', 'lesson', 'field_attendance_photo');
  if ($field !== NULL) {
    $field->delete();
  }
  $storage = FieldStorageConfig::loadByName('node', 'field_attendance_photo');
  if ($storage !== NULL) {
    $storage->delete();
  }

  workspace_events_purge_deleted_fields();

  // Deleting a field does not delete the files that its entities referenced.
  $usage = \Drupal::service('file.usage');
  \assert($usage instanceof FileUsageInterface);
  $file_storage = $entity_type_manager->getStorage('file');
  foreach ($references as $file_id => $entity_ids) {
    $file = $file_storage->load($file_id);
    if (!$file instanceof FileInterface) {
      continue;
    }
    foreach ($entity_ids as $entity_id) {
      $usage->delete($file, 'file', 'node', (string) $entity_id, 0);
    }
    if ($usage->listUsage($file) === []) {
      $file->delete();
    }
  }

  if (!\Drupal::moduleHandler()->moduleExists('ai_automators')) {
    return;
  }
  $remaining = $entity_type_manager->getStorage('ai_automator')->getQuery()
    ->accessCheck(FALSE)
    ->count()
    ->execute();
  if ((int) $remaining > 0) {
    return;
  }

  $uninstalled = \Drupal::service('module_installer')->uninstall(['ai_automators']);
  if ($uninstalled === FALSE) {
    throw new UpdateException('The module ai_automators could not be uninstalled. Remove the remaining automator configuration and run the update again.');
  }
}

/**
 * Implements hook_update_N().
 *
 * Adds the selectable OpenCode OCR backends to existing sites.
 *
 * Mistral stays the configured backend, so nothing changes until an
 * administrator switches providers in the settings form.
 */
function workspace_events_update_10015(): void {
  $loader = \Drupal::service(ConfigRecordLoader::class);
  \assert($loader instanceof ConfigRecordLoader);

  $storage = \Drupal::entityTypeManager()->getStorage('key');
  \assert($storage instanceof ConfigEntityStorageInterface);
  if ($storage->load(AttendanceRecognition::OPENCODE_KEY_ID) === NULL) {
    $storage->createFromStorageRecord($loader->load('key.key.' . AttendanceRecognition::OPENCODE_KEY_ID))->save();
  }

  $config = \Drupal::configFactory()->getEditable(AttendanceRecognition::SETTINGS);
  if (!$config->isNew()) {
    return;
  }

  foreach ($loader->load(AttendanceRecognition::SETTINGS) as $key => $value) {
    $config->set($key, $value);
  }
  $config->save();
}

/**
 * Implements hook_update_N().
 *
 * Installs the OpenCode AI providers and moves the attendance recognition to
 * the AI provider plugin manager.
 */
function workspace_events_update_10016(): void {
  if (!\Drupal::moduleHandler()->moduleExists('ai_provider_opencode')) {
    \Drupal::service('module_installer')->install(['ai_provider_opencode']);
  }

  $loader = \Drupal::service(ConfigRecordLoader::class);
  \assert($loader instanceof ConfigRecordLoader);
  $record = $loader->load(AttendanceRecognition::SETTINGS);
  unset($record['opencode_zen'], $record['opencode_go']);
  $record['provider_id'] = is_string($record['provider_id'] ?? NULL) ? $record['provider_id'] : '';
  $record['model_id'] = is_string($record['model_id'] ?? NULL) ? $record['model_id'] : '';

  $config = \Drupal::configFactory()->getEditable(AttendanceRecognition::SETTINGS);
  $old_backend = $config->get('backend');

  if (is_string($old_backend) && in_array($old_backend, ['opencode_zen', 'opencode_go'], TRUE)) {
    $old_model = $config->get($old_backend . '.model');
    $record['backend'] = AttendanceRecognition::BACKEND_AI_PROVIDER;
    $record['provider_id'] = $old_backend;
    $record['model_id'] = is_string($old_model) ? $old_model : '';
  }
  else {
    $record['backend'] = AttendanceRecognition::BACKEND_MISTRAL_OCR;
  }

  // Replacing all data also drops the nested settings of the old backends.
  $config->setData($record)->save();
}

/**
 * Deletes and purges all removed field definitions.
 *
 * The field data is deleted in batches, so a large site does not run out of
 * memory. field_purge_batch() is deprecated in Drupal 11.4; the purger is the
 * same operation without the deprecation.
 */
function workspace_events_purge_deleted_fields(): void {
  $purger = \Drupal::service(FieldPurger::class);
  \assert($purger instanceof FieldPurger);
  $repository = \Drupal::service('entity_field.deleted_fields_repository');
  \assert($repository instanceof DeletedFieldsRepositoryInterface);
  for ($i = 0; $i < 100; $i++) {
    if ($repository->getFieldDefinitions() === [] && $repository->getFieldStorageDefinitions() === []) {
      break;
    }
    $purger->purgeBatch(50);
  }
}

/**
 * Returns the files that the attendance photo field references.
 *
 * @return array<int, array<int, int>>
 *   The file IDs, each mapped to the node IDs that reference it.
 */
function workspace_events_attendance_photo_file_references(): array {
  $database = \Drupal::database();
  $references = [];
  foreach (['node__field_attendance_photo', 'node_revision__field_attendance_photo'] as $table) {
    if (!$database->schema()->tableExists($table)) {
      continue;
    }
    $result = $database->select($table, 'photo')
      ->fields('photo', ['entity_id', 'field_attendance_photo_target_id'])
      ->execute();
    if ($result === NULL) {
      continue;
    }
    foreach ($result as $row) {
      $row = (array) $row;
      $target = $row['field_attendance_photo_target_id'] ?? NULL;
      $entity = $row['entity_id'] ?? NULL;
      if (!is_numeric($target) || !is_numeric($entity)) {
        continue;
      }
      $file_id = (int) $target;
      $entity_id = (int) $entity;
      if ($file_id <= 0 || $entity_id <= 0) {
        continue;
      }
      $references[$file_id][$entity_id] = $entity_id;
    }
  }
  return $references;
}

/**
 * Deletes all content entities of an entity type in chunks.
 *
 * Used by the update hooks to remove entities before the module that provides
 * them is uninstalled.
 *
 * @param string $entity_type_id
 *   The entity type ID, for example "content_moderation_state".
 */
function workspace_events_delete_entities(string $entity_type_id): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition($entity_type_id)) {
    return;
  }
  $storage = $entity_type_manager->getStorage($entity_type_id);
  do {
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->range(0, 50)
      ->execute();
    if ($ids === []) {
      break;
    }
    $storage->delete($storage->loadMultiple($ids));
  } while (TRUE);
}

/**
 * Renames the fixed "Sonstige" organizer term if it still has the old label.
 *
 * Older sites created the term as "Extern". The label is only changed while it
 * still has that default, so a label an editor changed is kept.
 */
function workspace_events_rename_external_organizer(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('uuid', OrganizerResolver::EXTERNAL_UUID)
    ->range(0, 1)
    ->execute();
  if ($tids === []) {
    return;
  }
  $terms = $storage->loadMultiple($tids);
  $term = reset($terms);
  if (!$term instanceof Term) {
    return;
  }
  if ((string) $term->label() !== 'Extern') {
    return;
  }
  $term->setName('Sonstige');
  $term->save();
}

/**
 * Creates the organizer vocabulary when it does not exist yet.
 *
 * The vocabulary is part of the module configuration, so it is installed from
 * config/install on new sites. The update hook covers existing sites, where
 * configuration is imported separately.
 */
function workspace_events_ensure_organizer_vocabulary(): void {
  if (Vocabulary::load(OrganizerResolver::VOCABULARY) !== NULL) {
    return;
  }
  Vocabulary::create([
    'vid' => OrganizerResolver::VOCABULARY,
    'name' => 'Veranstalter',
    'description' => 'Wer eine Veranstaltung ausrichtet',
  ])->save();
}

/**
 * Creates the fixed organizer terms.
 *
 * Idempotent: the terms are looked up by UUID, so a second run does not create
 * duplicates and never overwrites labels that editors changed.
 */
function workspace_events_ensure_organizer_terms(): void {
  if (Vocabulary::load(OrganizerResolver::VOCABULARY) === NULL) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach (OrganizerResolver::TERMS as $uuid => $term) {
    $existing = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('uuid', $uuid)
      ->range(0, 1)
      ->execute();
    if ($existing !== []) {
      continue;
    }
    Term::create([
      'uuid' => $uuid,
      'vid' => OrganizerResolver::VOCABULARY,
      'name' => $term['name'],
      'weight' => $term['weight'],
    ])->save();
  }
}

/**
 * Creates the organizer field storage and instance when they do not exist yet.
 *
 * New sites get both from config/install. The update hook creates them on
 * existing sites, so the data conversion can copy the event type into the
 * organizer field before the configuration that removes the old field is
 * imported.
 */
function workspace_events_ensure_organizer_field(): void {
  if (FieldStorageConfig::loadByName('node', 'field_organizer') === NULL) {
    FieldStorageConfig::create([
      'field_name' => 'field_organizer',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => 1,
      'settings' => ['target_type' => 'taxonomy_term'],
    ])->save();
  }
  if (FieldConfig::loadByName('node', 'event', 'field_organizer') === NULL) {
    FieldConfig::create([
      'field_name' => 'field_organizer',
      'entity_type' => 'node',
      'bundle' => 'event',
      'label' => 'Veranstalter',
      'required' => TRUE,
      'field_storage' => FieldStorageConfig::loadByName('node', 'field_organizer'),
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [OrganizerResolver::VOCABULARY => OrganizerResolver::VOCABULARY],
          'sort' => ['field' => 'weight', 'direction' => 'ASC'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
  }
}

/**
 * Returns the node bundles managed by this module.
 *
 * @return string[]
 *   The node bundle machine names.
 */
function workspace_events_node_bundles(): array {
  return ['event', 'course'];
}

/**
 * Adds or removes a node bundle from the basic editorial workflow.
 *
 * Does nothing when the Workflows module has been uninstalled. Idempotent:
 * nothing is saved when the workflow is missing or already has the requested
 * state.
 *
 * @param string $bundle
 *   The node bundle machine name.
 * @param bool $include
 *   TRUE to add the bundle to the workflow, FALSE to remove it.
 */
function workspace_events_set_bundle_in_workflow(string $bundle, bool $include): void {
  if (!\Drupal::moduleHandler()->moduleExists('workflows')) {
    return;
  }
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('workflow')) {
    return;
  }
  $workflow = $entity_type_manager->getStorage('workflow')->load('basic_editorial');
  if ($workflow === NULL) {
    return;
  }
  $plugin = $workflow->getTypePlugin();
  $configuration = $plugin->getConfiguration();
  $entity_types = (array) ($configuration['entity_types'] ?? []);
  $bundles = isset($entity_types['node']) && is_array($entity_types['node']) ? $entity_types['node'] : [];
  if (in_array($bundle, $bundles, TRUE) === $include) {
    return;
  }
  $bundles = $include
    ? array_values(array_merge($bundles, [$bundle]))
    : array_values(array_filter($bundles, static fn (mixed $value): bool => $value !== $bundle));
  $entity_types['node'] = $bundles;
  $configuration['entity_types'] = $entity_types;
  $plugin->setConfiguration($configuration);
  $workflow->save();
}

/**
 * Returns the permissions granted to content editors.
 *
 * @return string[]
 *   The permission names.
 */
function workspace_events_editor_permissions(): array {
  return [
    'create event content',
    'edit any event content',
    'delete any event content',
    'create course content',
    'edit any course content',
    'delete any course content',
    'create terms in location',
    'edit terms in location',
    'delete terms in location',
    'create terms in organizer',
    'edit terms in organizer',
    'delete terms in organizer',
    'create terms in dance_figure',
    'edit terms in dance_figure',
    'delete terms in dance_figure',
    'access taxonomy overview',
    'edit any lesson content',
    'delete any lesson content',
    DanceFigureAccessHooks::VIEW_PERMISSION,
    AttendanceRecognition::PERMISSION,
  ];
}

/**
 * Grants the event and course permissions to the content editor role.
 */
function workspace_events_grant_editor_permissions(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  foreach (workspace_events_editor_permissions() as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Grants the dance figure permission to the member role.
 */
function workspace_events_grant_member_permissions(): void {
  $role = Role::load('member');
  if ($role === NULL) {
    return;
  }
  $role->grantPermission(DanceFigureAccessHooks::VIEW_PERMISSION);
  $role->save();
}

/**
 * Grants the flag permissions of a dance figure flag to the member role.
 *
 * @param \Drupal\workspace_events\DanceFigureFlag $flag
 *   The dance figure flag.
 */
function workspace_events_grant_flag_permissions(DanceFigureFlag $flag): void {
  $role = Role::load('member');
  if ($role === NULL) {
    return;
  }
  foreach ($flag->permissions() as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Revokes the event and course permissions from the content editor role.
 */
function workspace_events_revoke_editor_permissions(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  foreach (workspace_events_editor_permissions() as $permission) {
    $role->revokePermission($permission);
  }
  $role->save();
}

/**
 * Revokes the dance figure flag permissions from the member role.
 */
function workspace_events_revoke_flag_permissions(): void {
  $role = Role::load('member');
  if ($role === NULL) {
    return;
  }
  foreach (DanceFigureFlag::cases() as $flag) {
    foreach ($flag->permissions() as $permission) {
      $role->revokePermission($permission);
    }
  }
  $role->save();
}
