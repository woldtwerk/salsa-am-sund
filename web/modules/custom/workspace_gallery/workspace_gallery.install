<?php

/**
 * @file
 * Install, update and uninstall functions for the workspace_gallery module.
 */

declare(strict_types=1);

use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function workspace_gallery_install(bool $is_syncing = FALSE): void {
  workspace_gallery_grant_editor_permissions();
}

/**
 * Implements hook_uninstall().
 */
function workspace_gallery_uninstall(): void {
  workspace_gallery_revoke_editor_permissions();
}

/**
 * Implements hook_update_N().
 *
 * Removes the gallery bundle from the editorial workflow, so only pages stay
 * moderated.
 *
 * Does nothing when the Workflows module has been uninstalled.
 */
function workspace_gallery_update_11001(): void {
  workspace_gallery_remove_gallery_from_workflow();
}

/**
 * Removes the gallery bundle from the basic editorial workflow.
 *
 * Does nothing when the Workflows module has been uninstalled.
 */
function workspace_gallery_remove_gallery_from_workflow(): void {
  if (!\Drupal::moduleHandler()->moduleExists('workflows')) {
    return;
  }
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('workflow')) {
    return;
  }
  $workflow = $entity_type_manager->getStorage('workflow')->load('basic_editorial');
  if ($workflow === NULL) {
    return;
  }
  $plugin = $workflow->getTypePlugin();
  $configuration = $plugin->getConfiguration();
  $entity_types = (array) ($configuration['entity_types'] ?? []);
  $bundles = isset($entity_types['node']) && is_array($entity_types['node']) ? $entity_types['node'] : [];
  if (!in_array('gallery', $bundles, TRUE)) {
    return;
  }
  $bundles = array_values(array_filter($bundles, static fn (mixed $bundle): bool => $bundle !== 'gallery'));
  $entity_types['node'] = $bundles;
  $configuration['entity_types'] = $entity_types;
  $plugin->setConfiguration($configuration);
  $workflow->save();
}

/**
 * Returns the gallery permissions granted to content editors.
 *
 * @return string[]
 *   The permission names.
 */
function workspace_gallery_editor_permissions(): array {
  return [
    'create gallery content',
    'edit any gallery content',
    'delete any gallery content',
  ];
}

/**
 * Grants the gallery permissions to the content editor role.
 */
function workspace_gallery_grant_editor_permissions(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  foreach (workspace_gallery_editor_permissions() as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Revokes the gallery permissions from the content editor role.
 */
function workspace_gallery_revoke_editor_permissions(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  foreach (workspace_gallery_editor_permissions() as $permission) {
    $role->revokePermission($permission);
  }
  $role->save();
}
