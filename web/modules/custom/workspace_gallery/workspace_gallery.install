<?php

/**
 * @file
 * Install, update and uninstall functions for the workspace_gallery module.
 */

declare(strict_types=1);

use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function workspace_gallery_install(bool $is_syncing = FALSE): void {
  workspace_gallery_grant_editor_permissions();
}

/**
 * Implements hook_uninstall().
 */
function workspace_gallery_uninstall(): void {
  workspace_gallery_revoke_editor_permissions();
}

/**
 * Returns the gallery permissions granted to content editors.
 *
 * @return string[]
 *   The permission names.
 */
function workspace_gallery_editor_permissions(): array {
  return [
    'create gallery content',
    'edit any gallery content',
    'delete any gallery content',
  ];
}

/**
 * Grants the gallery permissions to the content editor role.
 */
function workspace_gallery_grant_editor_permissions(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  foreach (workspace_gallery_editor_permissions() as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Revokes the gallery permissions from the content editor role.
 */
function workspace_gallery_revoke_editor_permissions(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  foreach (workspace_gallery_editor_permissions() as $permission) {
    $role->revokePermission($permission);
  }
  $role->save();
}
