{
    "name": "drupal/cms",
    "version": "2.2.6",
    "description": "Drupal CMS is a ready-to-use platform built on Drupal core, offering smart defaults to get started quickly and enterprise-grade tools for marketers, designers, and content creators.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/cms",
    "support": {
        "User guide": "https://www.drupal.org/docs/drupal-cms",
        "Get help": "https://www.drupal.org/project/cms#support"
    },
    "repositories": [
        {
            "type": "path",
            "url": "web/modules/custom/*",
            "options": {
                "symlink": false
            },
            "only": [
                "workspace/*"
            ]
        },
        {
            "type": "path",
            "url": "web/themes/custom/*",
            "options": {
                "symlink": false
            },
            "only": [
                "workspace/*"
            ]
        },
        {
            "only": ["workspace/*"],
            "type": "path",
            "url": "misc/scaffold",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "drupal",
            "type": "composer",
            "url": "https://packages.drupal.org/8",
            "only": ["drupal/*"]
        },
        {
            "type": "package",
            "package": {
                "name": "npm-asset/quicklink",
                "version": "3.0.1",
                "description": "Quicklink prefetching library, served locally instead of from a third-party CDN.",
                "homepage": "https://github.com/GoogleChromeLabs/quicklink",
                "license": "Apache-2.0",
                "type": "drupal-library",
                "dist": {
                    "type": "tar",
                    "url": "https://registry.npmjs.org/quicklink/-/quicklink-3.0.1.tgz",
                    "shasum": "12bb507792594ad285880753c58196cc81d4e7d1"
                }
            }
        }
    ],
    "require": {
        "composer/composer": "^2.9.8",
        "composer/installers": "^2.3",
        "deployer/deployer": "^8.0",
        "drupal/ai": "^1.5",
        "drupal/automatic_updates": "^4.1",
        "drupal/autosave_form": "^1.10",
        "drupal/better_content_language_settings": "^1",
        "drupal/canvas": "^1.11",
        "drupal/canvas_translate": "^1@alpha",
        "drupal/coffee": "^2",
        "drupal/core": "^11.4",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-project-message": "^11.4",
        "drupal/core-recipe-unpack": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/core-vendor-hardening": "^11.4",
        "drupal/dashboard": "^2.2",
        "drupal/drupal_cms_helper": "^2",
        "drupal/drupal_cms_installer": "^2",
        "drupal/drupical": "^1",
        "drupal/easy_breadcrumb": "^2.0.9",
        "drupal/easy_email": "^3.0.2",
        "drupal/easy_email_theme": "^1",
        "drupal/eca": "^3.1.2",
        "drupal/field_group": "^3.6 || ^4",
        "drupal/flag": "^5.1",
        "drupal/focal_point": "^2.1",
        "drupal/gin": "^5",
        "drupal/gin_login": "^2.1.4",
        "drupal/honeypot": "^2.2",
        "drupal/key": "^1.22",
        "drupal/klaro": "^3",
        "drupal/language_checklist": "^1",
        "drupal/linkit": "^7",
        "drupal/login_emailusername": "^3",
        "drupal/mailsystem": "^4",
        "drupal/media_file_delete": "^1",
        "drupal/media_library_bulk_upload": "^1",
        "drupal/menu_link_attributes": "^1.5",
        "drupal/mercury": "^1.0.5",
        "drupal/metatag": "^2",
        "drupal/modeler": "^1",
        "drupal/navigation_extra_tools": "^1.3",
        "drupal/openid_connect": "^3.0@alpha",
        "drupal/pathauto": "^1.13",
        "drupal/project_browser": "^2.1.5",
        "drupal/quicklink": "^3.0",
        "drupal/recipe_locale": "^1",
        "drupal/redirect": "^1.10",
        "drupal/sam": "^1.2",
        "drupal/scheduler": "^2.2",
        "drupal/scheduler_content_moderation_integration": "^3.0.4",
        "drupal/seo_checklist": "^5.2.1",
        "drupal/simple_sitemap": "^4.2.2",
        "drupal/smart_date": "^4.3",
        "drupal/svg_image": "^3.1",
        "drupal/symfony_mailer_lite": "^2.0.1",
        "drupal/tagify": "^2.0.4",
        "drupal/tailwind_merge_classes": "^2.2",
        "drupal/token_or": "^2.2",
        "drupal/trash": "^3.0.13",
        "drupal/view_password": "^6",
        "drupal/yoast_seo": "^2.1",
        "drush/drush": "^13.7",
        "npm-asset/quicklink": "3.0.1",
        "sabre/vobject": "^4.5 || ^5.0",
        "workspace/scaffold": "dev-main",
        "workspace/workspace_admin_ui": "*"
    },
    "require-dev": {
        "behat/mink": "^1.11",
        "behat/mink-browserkit-driver": "^2.2",
        "drupal/coder": "^9.0",
        "mglaman/phpstan-drupal": "^2.2",
        "mikey179/vfsstream": "^1.6.11",
        "phpspec/prophecy-phpunit": "^2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.5.50",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/dom-crawler": "^7.4.12"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "drupal/core-vendor-hardening": true,
            "drupal/site_template_helper": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "bin-dir": "vendor/bin",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/.csslintrc": false,
                "[web-root]/.eslintignore": false,
                "[web-root]/.eslintrc.json": false,
                "[web-root]/example.gitignore": false,
                "[web-root]/INSTALL.txt": false,
                "[web-root]/README.md": false,
                "[web-root]/web.config": false,
                "[web-root]/modules/README.txt": false,
                "[web-root]/profiles/README.txt": false,
                "[web-root]/sites/README.txt": false,
                "[web-root]/themes/README.txt": false,
                "[web-root]/robots.txt": false,
                "[web-root]/sites/example.settings.local.php": false,
                "[project-root]/misc/deploy.yaml": false
            },
            "allowed-packages": ["drupal/drupal_cms_blank", "drupal/drupal_cms_site_template_base", "drupal/drupal_cms_starter", "workspace/scaffold"]
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "./drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "./recipes/{$name}": ["type:drupal-recipe"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "drupal-core-project-message": {
            "include-keys": ["support"],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                   </>",
                "<bg=blue;fg=white>  You're all set to get started with Drupal CMS!   </>",
                ""
            ]
        },
        "drupal-core-vendor-hardening": {
            "composer/composer": false
        }
    },
    "scripts": {
        "db:export": "drush sql:dump --ordered-dump --gzip --structure-tables-key=development --result-file=../misc/db/db.sql",
        "post-update-cmd": [
            "@php -r \"@unlink('vendor/bin/composer');\""
        ],
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "qa": [
            "@phpstan",
            "@phpcs"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php web/core/scripts/run-tests.sh --sqlite /tmp/run-tests.sqlite --dburl mysql://db:db@db/db --url http://localhost --concurrency 4 --suppress-deprecations --color --non-html --directory modules/custom"
        ]
    }
}
